<IfModule mod_headers.c>
    # Whitelist allowed origins and echo back the requesting Origin when matched
    SetEnvIfNoCase Origin "^http://localhost:3001$" ORIGIN_OK=$0
    SetEnvIfNoCase Origin "^http://localhost:3000$" ORIGIN_OK=$0
    SetEnvIfNoCase Origin "^https?://(www\.)?nggroupbd\.com$" ORIGIN_OK=$0
    SetEnvIfNoCase Origin "^https?://(www\.)?ecommerce\.nggroupbd\.com$" ORIGIN_OK=$0

    Header always set Access-Control-Allow-Origin "%{ORIGIN_OK}e" env=ORIGIN_OK
    Header always set Vary "Origin"
    Header always set Access-Control-Allow-Credentials "true" env=ORIGIN_OK
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Short-circuit preflight with 204 so browsers proceed
    RewriteCond %{REQUEST_METHOD} =OPTIONS
    RewriteRule ^ - [R=204,END]
</IfModule>
